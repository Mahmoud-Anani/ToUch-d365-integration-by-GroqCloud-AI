{
  "name": "touch-el-zanouki-business-intelligence",
  "version": "2.0.0",
  "description": "Touch El-Zanouki business intelligence assistant for read-only Dynamics 365 ERP data",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --use-system-ca --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --use-system-ca dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:d365": "tsx scripts/smoke-d365.ts",
    "smoke:groq": "tsx scripts/smoke-groq.ts",
    "hash-password": "tsx scripts/hash-password.ts"
  },
  "keywords": [
    "touch-el-zanouki",
    "el-zenouki-group",
    "home-appliances",
    "business-intelligence",
    "dynamics-365",
    "odata",
    "groq",
    "ai",
    "erp"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.8"
  }
}
