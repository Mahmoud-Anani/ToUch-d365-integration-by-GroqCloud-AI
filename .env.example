# ---------------------------------------------------------------------------
# Touch El-Zanouki Business Intelligence - environment example
# Copy to .env and fill in values. Never commit .env.
# ---------------------------------------------------------------------------

# Server
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info
# Set only when running behind a trusted reverse proxy (affects rate-limit IPs).
TRUST_PROXY=false

# Microsoft Dynamics 365 Finance & Operations (OAuth 2.0 client credentials)
D365_BASE_URL=https://your-environment.operations.dynamics.com
D365_TENANT_ID=your-tenant-id
# Leave empty to derive the standard Microsoft token endpoint from D365_TENANT_ID.
D365_TOKEN_URL=
D365_CLIENT_ID=your-client-id
D365_CLIENT_SECRET=your-client-secret
# Usually <D365_BASE_URL origin>/.default. Leave empty to derive it.
D365_SCOPE=
D365_REQUEST_TIMEOUT_MS=60000
# Optional legacy static bearer token (used only when client credentials are absent)
# D365_TOKEN=

# Metadata engine
AI_METADATA_CACHE_TTL=86400
METADATA_CACHE_DIR=data
METADATA_MAX_BYTES=134217728
D365_PAGE_SIZE=500
D365_ANALYTICS_MAX_ROWS=5000
D365_MAX_RESPONSE_BYTES=10485760

# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SUPPORTS_TOOLS=true
GROQ_TEMPERATURE=0.2
GROQ_TIMEOUT_MS=90000
GROQ_MAX_COMPLETION_TOKENS=1024
# Set each key and model to enable that provider. Free-tier access is account/model dependent.
# For ERP fallback, set *_SUPPORTS_TOOLS=true only for models verified to support tool calls.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_SUPPORTS_TOOLS=false
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_SUPPORTS_TOOLS=false
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_SUPPORTS_TOOLS=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SUPPORTS_TOOLS=false
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_SUPPORTS_TOOLS=false
AI_PRIMARY_PROVIDER=groq
AI_PROVIDER_ORDER=groq,gemini,cerebras,sambanova,openrouter,huggingface,ollama
AI_FALLBACK_ENABLED=true
AI_REQUEST_TIMEOUT=30000
AI_PROVIDER_COOLDOWN_MS=5000
AI_PROVIDER_MAX_COOLDOWN_MS=300000
# Optional custom providers (including local Ollama). Ollama does not require an API key.
# AI_FALLBACK_PROVIDERS=[{"name":"ollama-qwen","baseUrl":"http://localhost:11434/v1","model":"qwen2.5:7b","supportsTools":true}]

# AI agent limits
AI_MAX_TOOL_ITERATIONS=5
AI_MAX_TURN_COMPLETION_TOKENS=4096
AI_MAX_RESULT_ROWS=100
AI_MAX_TOOL_RESULT_ROWS=20
AI_MAX_HISTORY_MESSAGES=6
AI_MAX_CONTEXT_CHARS=24000
AI_MAX_SCHEMA_FIELDS=60
AI_MAX_GROUPS=50
AI_ENABLE_READ_ONLY=true

# Security / access
# Login is mandatory. Credentials live in config/users.json (scrypt hashes only).
# Generate a hash with: npm run hash-password -- "your-password"
USERS_FILE=config/users.json
# Required in production; at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_MS=28800000
SESSION_COOKIE_NAME=tez_session
# Defaults to true when NODE_ENV=production. Set false only for local HTTP tests.
# SESSION_COOKIE_SECURE=false
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
# Legacy trusted-proxy identity is ignored now that sessions are mandatory.
APP_TRUST_USER_HEADER=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=90
RATE_LIMIT_CHAT_MAX=20
REQUEST_BODY_LIMIT=128kb

# Conversations (JSON file store; no external database required)
CONVERSATION_STORE=file
CONVERSATION_FILE=data/conversations.json
CONVERSATION_MAX_PER_USER=100
CONVERSATION_MAX_MESSAGES=200
CONVERSATION_RETENTION_DAYS=30

# Optional JSON-lines audit log. Audit events never contain ERP record values.
# AUDIT_LOG_FILE=data/audit.log

# Optional data governance allow/deny lists (comma separated, * wildcard).
# Empty allowlist = all discovered entity sets are accessible.
D365_ENTITY_ALLOWLIST=
D365_ENTITY_DENYLIST=
D365_FIELD_ALLOWLIST=
D365_FIELD_DENYLIST=
